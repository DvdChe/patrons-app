# Copy to .env for local development.
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://patrons:patrons@localhost:5433/patrons

# Optional: S3-compatible media storage (Scaleway Object Storage, Garage, ...).
# When S3_BUCKET is empty, media files are stored on local disk (MEDIA_ROOT).
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
